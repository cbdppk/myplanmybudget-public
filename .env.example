# App
NEXT_PUBLIC_APP_NAME="MyPlanMyBudget"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Database - replace with your own local or demo database URL
DATABASE_URL="your-database-url-here"
DIRECT_URL="your-direct-database-url-here"
DB_IDENTITY_STRICT="true"

# Auth - replace with your own secrets
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="your-google-client-id-here"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"

# Optional API keys and integrations
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG="your-sentry-org-here"
SENTRY_PROJECT="your-sentry-project-here"
SENTRY_AUTH_TOKEN="your-sentry-auth-token-here"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Web Push Notifications
VAPID_SUBJECT="mailto:admin@example.com"
VAPID_PUBLIC_KEY="your-vapid-public-key-here"
VAPID_PRIVATE_KEY="your-vapid-private-key-here"
PUSH_DISPATCH_SECRET="your-push-dispatch-secret-here"

# Email - use demo or development credentials only
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user-here"
SMTP_PASS="your-smtp-password-here"
SMTP_FROM="noreply@example.com"

# Performance logging
PERF_LOGS="false"
SLOW_QUERY_MS="700"
OP_SLOW_MS="1200"
DB_TX_MAX_WAIT_MS="10000"
DB_TX_TIMEOUT_MS="15000"
