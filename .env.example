
# Database (Neon / PostgreSQL)
# DATABASE_URL = pooled connection string (used by Prisma Client at runtime)
# DIRECT_URL   = unpooled connection string (used by Prisma CLI for migrations + prismaAdmin client)
DATABASE_URL=postgresql://app_runtime_user:replace_me@db-host:5432/neondb?sslmode=require
DIRECT_URL=postgresql://db_owner_user:replace_me@db-host:5432/neondb?sslmode=require

NEXT_PUBLIC_APP_NAME=MyplanMybudget
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth
AUTH_SECRET=replace_me
NEXTAUTH_SECRET=replace_me
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me

# Security
# Keep strict identity enabled when using an RLS runtime role (e.g. app_runtime_user).
# If set to false while using app_runtime_user, runtime will auto-force strict mode.
DB_IDENTITY_STRICT=true

# Performance logging (set PERF_LOGS=true to enable slow query/operation logs)
PERF_LOGS=false
SLOW_QUERY_MS=700
OP_SLOW_MS=1200
DB_TX_MAX_WAIT_MS=10000
DB_TX_TIMEOUT_MS=15000

# Error tracking (Sentry) — leave blank to disable in dev; Sentry no-ops gracefully
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=replace_me
SENTRY_PROJECT=replace_me
SENTRY_AUTH_TOKEN=replace_me

# Web Push Notifications (VAPID)
# Generate keys with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@yourdomain.com
VAPID_PUBLIC_KEY=replace_me
VAPID_PRIVATE_KEY=replace_me
PUSH_DISPATCH_SECRET=replace_me_with_long_random_secret

# Email (SMTP) — used for email verification, password reset, and reminders
# Recommended provider: Resend (resend.com) — free tier 3,000 emails/month
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=re_your_api_key_here   ← get from resend.com/api-keys
#   SMTP_FROM=noreply@yourdomain.com ← must match a verified domain in Resend
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=replace_me
SMTP_FROM=noreply@yourdomain.com

# Bot protection — Cloudflare Turnstile (free at dash.cloudflare.com/turnstile)
# Add a new site → copy Site Key (public) and Secret Key (server-only)
# Leave blank in local dev — bot check is automatically skipped when unset
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
