{
  "name": "myplanmybudget",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm prisma:generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "node tools/smoke-check.mjs",
    "test:sim": "node --test tests/simulation-engine.test.mjs",
    "analyze": "ANALYZE=true pnpm run build",
    "size": "size-limit",
    "lhci": "lhci autorun",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node --loader ts-node/esm/transpile-only prisma/seed.ts",
    "docs:pdf1": "python3 docs/pdf1-product/generate_pdf.py",
    "status:update": "node tools/update-status.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@auth/prisma-adapter": "^2.11.2",
    "@marsidev/react-turnstile": "^1.4.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@sentry/nextjs": "^10.63.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.473.0",
    "next": "^15.5.21",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^9.0.3",
    "otplib": "^13.3.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.58.2",
    "@size-limit/preset-small-lib": "^12.0.0",
    "@types/node": "25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.19.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.1",
    "prisma": "^7.8.0",
    "size-limit": "^12.0.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "wait-on": "^9.1.0"
  },
  "size-limit": [
    {
      "name": "Main JS bundle (first load)",
      "path": ".next/static/chunks/main-*.js",
      "limit": "200 kB",
      "gzip": true
    },
    {
      "name": "Framework chunk",
      "path": ".next/static/chunks/framework-*.js",
      "limit": "50 kB",
      "gzip": true
    }
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "minimatch@<4": "3.1.4",
      "minimatch@>=9 <10": "9.0.7",
      "ajv@<7": "6.14.0"
    }
  }
}
